{
  "manifest_version": 3,
  "name": "Cicerón: navegador",
  "version": "2.2.6",
  "description": "Pausa Feed y herramientas de Cicerón para el navegador.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://twitter.com/*",
    "https://*.twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "hard_block",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_title": "Cicerón",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/ciceron-16.png",
      "32": "icons/ciceron-32.png",
      "48": "icons/ciceron-48.png",
      "128": "icons/ciceron-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://*.youtube.com/*",
        "https://youtu.be/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "key": "",
  "icons": {
    "16": "icons/ciceron-16.png",
    "32": "icons/ciceron-32.png",
    "48": "icons/ciceron-48.png",
    "128": "icons/ciceron-128.png"
  }
}
